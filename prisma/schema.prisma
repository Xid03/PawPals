generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum SwipeAction {
  LIKE
  SKIP
}

enum PostTopic {
  HEALTH
  BEHAVIOR
  FOOD
  GENERAL
  MEMES
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MessageType {
  TEXT
  IMAGE
  STICKER
}

enum VetServiceType {
  CHECKUP
  VACCINATION
  DENTAL
  SURGERY
  EMERGENCY
}

enum EventCategory {
  NEARBY
  WORKSHOPS
  MEETUPS
  ADOPTION
}

enum HealthTipCategory {
  NUTRITION
  GROOMING
  BEHAVIOR
  WELLNESS
  PREVENTIVE_CARE
}

enum NotificationType {
  NEW_MATCH
  NEW_MESSAGE
  POST_LIKE
  POST_COMMENT
  EVENT_REMINDER
  FOLLOW_REQUEST
  NEW_FOLLOWER
}

enum FollowRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String?
  name            String
  username        String          @unique
  bio             String?
  avatarUrl       String?
  city            String?
  isPrivate       Boolean         @default(false)
  latitude        Float?
  longitude       Float?
  provider        AuthProvider    @default(EMAIL)
  providerId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cats            CatProfile[]
  following       Follow[]        @relation("following")
  followers       Follow[]        @relation("followers")
  sentFollowRequests     FollowRequest[] @relation("sentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("receivedFollowRequests")
  posts           Post[]
  comments        Comment[]
  postLikes       Like[]
  savedPosts      SavedPost[]
  stories         Story[]
  storyLikes      StoryLike[]
  swipes          Swipe[]
  matchesAsUserA  Match[]         @relation("matchUserA")
  matchesAsUserB  Match[]         @relation("matchUserB")
  conversations   ConversationParticipant[]
  messages        Message[]
  favoriteVets    FavoriteVet[]
  events          Event[]
  eventRsvps      EventRSVP[]
  savedEvents     SavedEvent[]
  savedHealthTips SavedHealthTip[]
  notifications   Notification[]

  @@index([city])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model FollowRequest {
  id          String              @id @default(cuid())
  requesterId String
  targetId    String
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester   User                @relation("sentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User                @relation("receivedFollowRequests", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model CatProfile {
  id              String     @id @default(cuid())
  ownerId         String
  name            String
  ageMonths       Int
  gender          Gender     @default(UNKNOWN)
  breed           String
  personalityTags String[]
  lookingFor      String[]
  latitude        Float?
  longitude       Float?
  city            String?
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos          CatPhoto[]
  swipesReceived  Swipe[]    @relation("swipedCat")

  @@index([ownerId])
  @@index([breed])
  @@index([gender])
  @@index([city])
}

model CatPhoto {
  id        String     @id @default(cuid())
  catId     String
  url       String
  caption   String?
  createdAt DateTime   @default(now())

  cat       CatProfile @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
}

model Swipe {
  id        String      @id @default(cuid())
  userId    String
  catId     String
  action    SwipeAction
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat       CatProfile  @relation("swipedCat", fields: [catId], references: [id], onDelete: Cascade)

  @@unique([userId, catId])
  @@index([catId])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("matchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("matchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Post {
  id        String      @id @default(cuid())
  authorId  String
  text      String
  topic     PostTopic   @default(GENERAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images    PostImage[]
  likes     Like[]
  comments  Comment[]
  saves     SavedPost[]

  @@index([authorId])
  @@index([topic])
  @@index([createdAt])
}

model PostImage {
  id        String    @id @default(cuid())
  postId    String
  url       String
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Story {
  id        String      @id @default(cuid())
  authorId  String
  url       String
  type      MediaType   @default(IMAGE)
  caption   String?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]
  likes     StoryLike[]

  @@index([expiresAt])
  @@index([authorId])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryLike {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  matchId      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  body           String
  data           Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Vet {
  id           String        @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  websiteUrl   String?
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  rating       Float         @default(0)
  isOpen       Boolean       @default(true)
  openHours    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  services     VetService[]
  favorites    FavoriteVet[]

  @@index([city])
  @@index([rating])
  @@index([isOpen])
}

model VetService {
  id      String         @id @default(cuid())
  vetId   String
  type    VetServiceType

  vet     Vet            @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@unique([vetId, type])
}

model FavoriteVet {
  id        String   @id @default(cuid())
  vetId     String
  userId    String
  createdAt DateTime @default(now())

  vet       Vet      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vetId, userId])
}

model Event {
  id          String        @id @default(cuid())
  organizerId String
  title       String
  description String?
  category    EventCategory
  imageUrl    String?
  startsAt    DateTime
  location    String
  city        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer   User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps       EventRSVP[]
  saves       SavedEvent[]

  @@index([startsAt])
  @@index([category])
  @@index([city])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model HealthTip {
  id          String            @id @default(cuid())
  title       String
  body        String
  category    HealthTipCategory
  imageUrl    String?
  isDaily     Boolean           @default(false)
  publishedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  saves       SavedHealthTip[]

  @@index([category])
  @@index([isDaily])
  @@index([publishedAt])
}

model SavedHealthTip {
  id          String    @id @default(cuid())
  healthTipId String
  userId      String
  createdAt   DateTime  @default(now())

  healthTip   HealthTip @relation(fields: [healthTipId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([healthTipId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}
